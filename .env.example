# ============================================================
# AI求职智能管家 - 环境配置模板
# 使用方式: 复制此文件为 .env，填写实际配置值
# 注意: .env 文件包含敏感信息，禁止上传至 Git
# ============================================================

# === 大模型配置 ===
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# === 风控参数 ===
MAX_DAILY_DELIVERY=20
MIN_DELAY_SECONDS=2
MAX_DELAY_SECONDS=4
DELIVERY_START_HOUR=9
DELIVERY_END_HOUR=18
MATCH_THRESHOLD=70

# === 安全配置 ===
# AES加密密钥（32字节base64编码，首次运行时自动生成）
ENCRYPTION_KEY=
# Cookie过期天数（超过此天数无操作自动清除登录状态）
COOKIE_EXPIRE_DAYS=7

# === 平台配置 ===
# 当前支持: boss（BOSS直聘）
PLATFORM=boss

# === 服务配置 ===
# Gradio 服务端口
SERVER_PORT=7860

# === 调试模式 ===
DEBUG=false
